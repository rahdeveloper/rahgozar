# Copy to keystore.properties and fill in. Never commit the real file, and
# never commit the .jks it points at.
#
# CI can set these as environment variables instead:
#   RAHGOZAR_KEYSTORE_FILE  RAHGOZAR_KEYSTORE_PASSWORD
#   RAHGOZAR_KEY_ALIAS      RAHGOZAR_KEY_PASSWORD
#
# Create the key once (it cannot be replaced later without every installed app
# refusing the update):
#
#   keytool -genkeypair -v -keystore rahgozar-release.jks \
#           -alias rahgozar -keyalg RSA -keysize 4096 -validity 10000
#
# Then read the certificate fingerprint the panel needs:
#
#   keytool -list -v -keystore rahgozar-release.jks -alias rahgozar | grep SHA256
#
# and add it under «امضاهای مجاز» in the panel. Until it is there, ENV=prod
# refuses every registration. See docs/RELEASE.md.

# Relative to android/app/, or absolute.
storeFile=rahgozar-release.jks
storePassword=
keyAlias=rahgozar
keyPassword=
