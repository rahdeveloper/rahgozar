@@ -0,0 +1,54 @@
+package wireguard
+
+import (
+	"net/netip"
+	"testing"
+)
+
+// ClientBind is the bind used when a WireGuard endpoint rides a detour — which
+// is exactly how an AmneziaWG endpoint gets its UDP carried inside someone
+// else's TCP. It was rewriting bytes 1-3 of every packet for Cloudflare WARP's
+// "reserved" field, which is the same space AmneziaWG puts its magic header in,
+// so an AWG endpoint on a detour dropped every packet. These tests pin the
+// guard that decides whether that rewrite happens at all.
+
+func TestHasReservedIsFalseWhenNothingIsConfigured(t *testing.T) {
+	bind := &ClientBind{reservedForEndpoint: make(map[netip.AddrPort][3]uint8)}
+	if bind.hasReserved() {
+		t.Fatal("a bind with no reserved value must not rewrite header bytes")
+	}
+}
+
+func TestHasReservedIsFalseForAllZeroPerEndpointValues(t *testing.T) {
+	// The per-endpoint map is populated for every peer, so its mere presence
+	// says nothing. Only a non-zero value means WARP.
+	bind := &ClientBind{
+		reservedForEndpoint: map[netip.AddrPort][3]uint8{
+			netip.MustParseAddrPort("203.0.113.10:51820"): {0, 0, 0},
+		},
+	}
+	if bind.hasReserved() {
+		t.Fatal("an all-zero per-endpoint reserved value must not count")
+	}
+}
+
+func TestHasReservedIsTrueForADeviceWideValue(t *testing.T) {
+	bind := &ClientBind{
+		reserved:            [3]uint8{1, 2, 3},
+		reservedForEndpoint: make(map[netip.AddrPort][3]uint8),
+	}
+	if !bind.hasReserved() {
+		t.Fatal("a configured device-wide reserved value must still be honoured")
+	}
+}
+
+func TestHasReservedIsTrueForAPerEndpointValue(t *testing.T) {
+	bind := &ClientBind{
+		reservedForEndpoint: map[netip.AddrPort][3]uint8{
+			netip.MustParseAddrPort("203.0.113.10:51820"): {9, 0, 0},
+		},
+	}
+	if !bind.hasReserved() {
+		t.Fatal("a per-endpoint reserved value must still be honoured")
+	}
+}
