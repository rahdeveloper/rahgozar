diff --git a/transport/wireguard/awg_ipc_rahgozar_test.go b/transport/wireguard/awg_ipc_rahgozar_test.go
new file mode 100644
index 0000000..159c730
--- /dev/null
+++ b/transport/wireguard/awg_ipc_rahgozar_test.go
@@ -0,0 +1,76 @@
+//go:build with_awg
+
+package wireguard
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+// The app builds AmneziaWG endpoints by writing these option fields, so what
+// this file pins down is the contract between the config generator and the
+// device: which keys reach IpcSet, in what form, and which inputs are refused
+// before they can reach a running device.
+
+func TestAWGIpcLinesUnsetIsEmpty(t *testing.T) {
+	// A plain WireGuard endpoint must produce byte-identical device config to
+	// upstream even in a with_awg build — otherwise turning the tag on would
+	// silently change every existing endpoint.
+	lines, err := awgIpcLines(option.AmneziaWGOptions{})
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if lines != "" {
+		t.Fatalf("expected no lines for an unset config, got %q", lines)
+	}
+}
+
+func TestAWGIpcLinesRendersParameters(t *testing.T) {
+	lines, err := awgIpcLines(option.AmneziaWGOptions{
+		Jc: 4, Jmin: 40, Jmax: 70,
+		S1: 15, S2: 20,
+		H1: "1234567", H2: "2345678", H3: "3456789-4000000", H4: "4567890",
+	})
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	for _, want := range []string{
+		"\njc=4", "\njmin=40", "\njmax=70",
+		"\ns1=15", "\ns2=20",
+		"\nh1=1234567", "\nh2=2345678", "\nh4=4567890",
+		// A ranged magic header keeps its "min-max" form all the way to IpcSet;
+		// collapsing it to a single value would drop the randomisation that
+		// makes the header unfingerprintable.
+		"\nh3=3456789-4000000",
+	} {
+		if !strings.Contains(lines, want) {
+			t.Errorf("missing %q in %q", want, lines)
+		}
+	}
+	// Zero-valued keys are omitted rather than sent as 0: amneziawg-go treats a
+	// present-but-zero s3/s4 differently from absent.
+	for _, unwanted := range []string{"\ns3=", "\ns4=", "\ni1=", "\ni2="} {
+		if strings.Contains(lines, unwanted) {
+			t.Errorf("unexpected %q in %q", unwanted, lines)
+		}
+	}
+}
+
+func TestAWGIpcLinesRejectsInvertedJunkRange(t *testing.T) {
+	// jmin > jmax makes amneziawg-go's rand.Int argument non-positive and
+	// panics in the retransmit-timer goroutine, long after the config was
+	// accepted. It has to fail here, where there is someone to tell.
+	_, err := awgIpcLines(option.AmneziaWGOptions{Jc: 3, Jmin: 90, Jmax: 40})
+	if err == nil {
+		t.Fatal("expected jmin > jmax to be rejected")
+	}
+}
+
+func TestAWGIpcLinesRejectsInvalidMagicHeader(t *testing.T) {
+	_, err := awgIpcLines(option.AmneziaWGOptions{H1: "5000-100"})
+	if err == nil {
+		t.Fatal("expected a reversed magic header range to be rejected")
+	}
+}
diff --git a/transport/wireguard/awg_reserved_rahgozar_test.go b/transport/wireguard/awg_reserved_rahgozar_test.go
