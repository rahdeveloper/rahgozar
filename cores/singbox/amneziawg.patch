+//go:build !with_awg
+
+package wireguard
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+// Without the tag the AWG parameters must be refused, not ignored. A build that
+// quietly dropped them would hand the user a plain WireGuard tunnel while the
+// panel and the UI both said AmneziaWG — the obfuscation gone and nobody told.
+
+func TestAWGStubRejectsAConfiguredEndpoint(t *testing.T) {
+	_, err := awgIpcLines(option.AmneziaWGOptions{Jc: 4, Jmin: 40, Jmax: 70})
+	if err == nil {
+		t.Fatal("expected an AWG config to be rejected in a build without with_awg")
+	}
+}
+
+func TestAWGStubAllowsAPlainEndpoint(t *testing.T) {
+	lines, err := awgIpcLines(option.AmneziaWGOptions{})
+	if err != nil {
+		t.Fatalf("a plain WireGuard endpoint must still build: %v", err)
+	}
+	if lines != "" {
+		t.Fatalf("expected no device lines, got %q", lines)
+	}
+}
